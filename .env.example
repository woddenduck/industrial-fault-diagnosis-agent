# 工业故障诊断 Agent 统一配置模板
# 使用方法：cp .env.example .env，然后按当前机器环境修改 .env。

# ---------- Conda 环境 ----------
LLM_CONDA_ENV=vllm_qwen3
EMBEDDING_CONDA_ENV=embedding_service
RERANKER_CONDA_ENV=reranker_service
GATEWAY_CONDA_ENV=llm_gateway
RAG_CONDA_ENV=rag_system
AGENT_CONDA_ENV=agent_system

# ---------- 公共运行目录 ----------
HF_HOME=.cache/huggingface
LOG_DIR=logs
RUN_DIR=deployment/run
TOKENIZERS_PARALLELISM=false
LOG_LEVEL=INFO

# ---------- vLLM ----------
LLM_START_MODE=local
LLM_HOST=0.0.0.0
LLM_PORT=6006
LLM_BASE_URL=http://127.0.0.1:6006
LLM_MODEL_PATH=Qwen/Qwen3-8B
LLM_SERVED_MODEL_NAME=Qwen/Qwen3-8B
LLM_MAX_MODEL_LEN=4096
LLM_GPU_MEMORY_UTILIZATION=0.85
LLM_DTYPE=auto
LLM_TIMEOUT_SECONDS=120

# ---------- Embedding ----------
EMBEDDING_HOST=0.0.0.0
EMBEDDING_PORT=6010
EMBEDDING_BASE_URL=http://127.0.0.1:6010
EMBEDDING_MODEL_PATH=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_MAX_TEXTS=32
EMBEDDING_MAX_CHARS=12000
EMBEDDING_MAX_TOKENS=2048
EMBEDDING_BATCH_SIZE=8
EMBEDDING_LOG_LEVEL=INFO

# ---------- Reranker ----------
RERANKER_HOST=0.0.0.0
RERANKER_PORT=6009
RERANKER_BASE_URL=http://127.0.0.1:6009
RERANKER_MODEL_PATH=Qwen/Qwen3-Reranker-0.6B
RERANKER_DEVICE=cpu
RERANKER_MAX_DOCUMENTS=50
RERANKER_MAX_LENGTH=1024
RERANKER_BATCH_SIZE=4
RERANKER_LOG_LEVEL=INFO

# ---------- Gateway ----------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=6008
GATEWAY_BASE_URL=http://127.0.0.1:6008

# ---------- Industrial RAG ----------
RAG_HOST=0.0.0.0
RAG_PORT=8000
RAG_BASE_URL=http://127.0.0.1:8000
RAG_DATA_DIR=industrial-rag/data
RAG_MODEL_DIR=industrial-rag/models
RAG_UPLOAD_DIR=industrial-rag/data/uploads
RAG_VECTOR_DB_DIR=industrial-rag/data/vector_store
RAG_LOG_DIR=industrial-rag/logs
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5
SIMILARITY_THRESHOLD=0.0
VECTOR_DISTANCE_THRESHOLD=1.0
HTTP_TIMEOUT=30
LLM_TIMEOUT=120
MODEL_MAX_CONTEXT=8192
CONTEXT_TOKEN_BUDGET=4096
HISTORY_TOKEN_BUDGET=1024

# ---------- Agent API ----------
AGENT_HOST=0.0.0.0
AGENT_PORT=8010
AGENT_BASE_URL=http://127.0.0.1:8010
AGENT_DATA_DIR=data
DEVICE_STATUS_FILE=data/device_status.json
MAINTENANCE_HISTORY_FILE=data/maintenance_history.json
DEFAULT_DEVICE_MODEL=G120C
# 首次构建知识库后，在本机 .env 中填写真实 ID。
DEFAULT_KNOWLEDGE_BASE_ID=
RAG_TIMEOUT=60
RAG_MAX_RETRIES=1

# ---------- 真实 HTTP 端到端测试 ----------
E2E_DEVICE_ID=DEVICE-001
E2E_DEVICE_MODEL=G120C
E2E_KNOWLEDGE_BASE_ID=
E2E_HTTP_TIMEOUT=90

# ---------- 启动等待时间（秒） ----------
LLM_STARTUP_TIMEOUT=300
EMBEDDING_STARTUP_TIMEOUT=180
RERANKER_STARTUP_TIMEOUT=180
GATEWAY_STARTUP_TIMEOUT=60
RAG_STARTUP_TIMEOUT=90
AGENT_STARTUP_TIMEOUT=60
