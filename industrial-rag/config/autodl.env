# Day21 Stage2 - AutoDL environment
# Python code contains no AutoDL absolute path. Environment-specific paths belong here.

# =========================
# Service endpoints
# =========================
LLM_BASE_URL=http://127.0.0.1:6006
EMBEDDING_BASE_URL=http://127.0.0.1:6010
RERANKER_BASE_URL=http://127.0.0.1:6009

# =========================
# Service ports
# =========================
LLM_PORT=6006
EMBEDDING_PORT=6010
RERANKER_PORT=6009
GATEWAY_PORT=6008
RAG_PORT=8000

# =========================
# Filesystem
# =========================
DATA_DIR=data

# 模型由独立服务加载。此目录只作为 RAG 的运行目录校验项，
# 保持相对路径，避免绑定某一台 AutoDL 实例。
MODEL_DIR=models

UPLOAD_DIR=data/uploads
VECTOR_DB_DIR=data/vector_store
LOG_DIR=logs

# =========================
# Retrieval
# =========================
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5
SIMILARITY_THRESHOLD=0.0

# =========================
# Network timeout (seconds)
# =========================
HTTP_TIMEOUT=30
LLM_TIMEOUT=120

# =========================
# Context budget
# =========================
MODEL_MAX_CONTEXT=8192
CONTEXT_TOKEN_BUDGET=4096
HISTORY_TOKEN_BUDGET=1024
