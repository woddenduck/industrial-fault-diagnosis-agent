# Industrial RAG configuration template
#
# Usage:
#   cp .env.example config/local.env
#   # then edit config/local.env for your machine
#
# Do not put API keys/secrets into committed env files.

LLM_BASE_URL=http://127.0.0.1:6006
EMBEDDING_BASE_URL=http://127.0.0.1:6010
RERANKER_BASE_URL=http://127.0.0.1:6009

LLM_PORT=6006
EMBEDDING_PORT=6010
RERANKER_PORT=6009
GATEWAY_PORT=6008
RAG_PORT=8000

# Relative paths are resolved from PROJECT_ROOT, not from the shell's cwd.
DATA_DIR=data
MODEL_DIR=models
UPLOAD_DIR=data/uploads
VECTOR_DB_DIR=data/vector_store
LOG_DIR=logs

RETRIEVAL_TOP_K=10
RERANK_TOP_K=5
SIMILARITY_THRESHOLD=0.0

HTTP_TIMEOUT=30
LLM_TIMEOUT=120

MODEL_MAX_CONTEXT=8192
CONTEXT_TOKEN_BUDGET=4096
HISTORY_TOKEN_BUDGET=1024
